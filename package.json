{
  "name": "@typecall/admin-sdk",
  "version": "0.2.0",
  "description": "JS/TS Admin SDK for Typecall APIs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fabric/*": {
      "types": "./dist/fabric/*.d.ts",
      "import": "./dist/fabric/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "typecall",
    "admin",
    "sdk",
    "typescript"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typecall/admin-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/typecall/admin-sdk-js/issues"
  },
  "homepage": "https://github.com/typecall/admin-sdk-js#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "nanostores": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
